# Server configuration
PORT=3000

# Database configuration
# Use DB_HOST=localhost when running the API on your machine.
# Docker Compose overrides DB_HOST to "db" for the api service.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=task_management

# Environment configuration
NODE_ENV=development

# Swagger UI at /api-docs (set to false to disable)
SWAGGER_ENABLED=true

# JWT authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Password hashing (bcrypt salt rounds)
BCRYPT_SALT_ROUNDS=10

# Optional: email that receives admin role on registration
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Optional: seed an admin user on startup (set SEED_ADMIN=true)
SEED_ADMIN=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin

# Auth rate limiting (per IP)
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000